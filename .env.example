# ============================================================
# AetherLive Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Convex (Backend)
NEXT_PUBLIC_CONVEX_URL=

# AI (Convex backend actions — via AI Credits gateway, OpenAI-compatible)
# Set in Convex Dashboard > Settings > Environment Variables (read via process.env in actions).
# NOTE: there is no OPENAI_API_KEY — do not use api.openai.com; use https://api.aicredits.in/v1.
AI_Credits_API_KEY=

# Vapi AI (Voice Agent — per-org keys stored in DB secrets; this is the server fallback)
# Set in Convex Dashboard > Settings > Environment Variables.
VAPI_API_KEY=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Embed Widget (development)
VITE_WIDGET_URL=http://localhost:3001

# Widget origin baked into Dashboard → Integrations snippets (defaults to production)
NEXT_PUBLIC_WIDGET_URL=https://widget.aetherlive.live

# Razorpay (Billing — supports INR + USD)
# Create 2 plans in Razorpay Dashboard > Subscriptions > Plans:
#   Pro INR: Rs 499/mo, Pro USD: $20/mo — paste plan IDs below.
# Set these in Convex Dashboard > Settings > Environment Variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_INR_PLAN_ID=plan_xxx
RAZORPAY_PRO_USD_PLAN_ID=plan_yyy
RAZORPAY_WEBHOOK_SECRET=
