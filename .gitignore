# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
# Secret & environment files — NEVER commit these
# ============================================================

# Local env files (contain API keys, secrets, DSNs)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Sentry — contains auth token for source map uploads
.env.sentry-build-plugin

# Sentry CLI config (may contain auth tokens)
.sentryclirc

# Allow template/example env files to be committed
!.env.example
!.env.*.example

# Certificates & private keys
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
