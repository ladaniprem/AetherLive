{
    "extends": "@workspace/typescript-config/nextjs.json",
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "5.0",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@workspace/ui/*": [
                "../../packages/ui/src/*"
            ],
            "@workspace/backend/*": [
                "../../packages/backend/convex/*"
            ],
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}